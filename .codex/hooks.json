{
  "description": "Safety and quality hooks for the Moft PWA repository.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session_context.mjs\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; node \\\"$root/.codex/hooks/session_context.mjs\\\"\"",
            "timeout": 15,
            "statusMessage": "Loading Moft project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.mjs\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; node \\\"$root/.codex/hooks/pre_tool_use_policy.mjs\\\"\"",
            "timeout": 15,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_review.mjs\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; node \\\"$root/.codex/hooks/post_tool_review.mjs\\\"\"",
            "timeout": 15,
            "statusMessage": "Reviewing project changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_quality_gate.mjs\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; node \\\"$root/.codex/hooks/stop_quality_gate.mjs\\\"\"",
            "timeout": 30,
            "statusMessage": "Checking Moft completion gate"
          }
        ]
      }
    ]
  }
}
